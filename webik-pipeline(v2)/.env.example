# ============================================================
#  WEBIK PIPELINE — Environment Variables
#  Скопируй в .env и заполни своими ключами
# ============================================================

# === LLM (главный мозг) ===
ANTHROPIC_API_KEY=sk-ant-...

# === TTS (Voicer API — обёртка над ElevenLabs через voiceapi.csv666.ru) ===
VOICER_API_KEY=
# UUID шаблона голоса (получить через GET /templates). Для канала Webik — "Webik V3".
VOICER_TEMPLATE_UUID=

# === fal.ai (Flux, Kling, Veo через одну точку) ===
FAL_KEY=

# === Стоковые источники (бесплатные) ===
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# === 3D Camera ===
IMMERSITY_API_KEY=

# === Музыка ===
SUNO_API_KEY=

# === SFX ===
FREESOUND_API_KEY=

# === YouTube ===
YOUTUBE_CLIENT_SECRETS_PATH=./youtube_credentials.json
YOUTUBE_TOKEN_PATH=./youtube_token.json

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Premiere ===
# Windows
PREMIERE_PATH=C:\Program Files\Adobe\Adobe Premiere Pro 2025\Adobe Premiere Pro.exe
# macOS
# PREMIERE_PATH=/Applications/Adobe Premiere Pro 2025/Adobe Premiere Pro.app

# === Pipeline Settings ===
DEFAULT_VIDEO_RESOLUTION=1920x1080
DEFAULT_FRAMERATE=30
ASSETS_QUALITY=high
USE_LOCAL_DEPTH=false
USE_LOCAL_WHISPER=true

# === Paths ===
PROJECTS_DIR=./projects
TEMPLATES_DIR=./templates
LUTS_DIR=./luts
OVERLAYS_DIR=./overlays
